# Day 4 - Arithmetic Operations, Number Types and Comparisons


# -----------------------------------------
# 1. Basic arithmetic operations
# -----------------------------------------
# Python can perform mathematical calculations
# using arithmetic operators.

print(5 + 2)
print(5 - 2)
print(5 * 2)
print(5 / 2)


# -----------------------------------------
# 2. Arithmetic operations with messages
# -----------------------------------------
# We can add text to our output to make
# the result easier to understand.

print("Addition:", 5 + 2)
print("Subtraction:", 5 - 2)
print("Multiplication:", 5 * 2)
print("Division:", 5 / 2)


# -----------------------------------------
# 3. Using variables in arithmetic
# -----------------------------------------
# Numbers can be stored in variables
# and then used in calculations.

number1 = 10
number2 = 3

print("Addition:", number1 + number2)
print("Subtraction:", number1 - number2)
print("Multiplication:", number1 * number2)
print("Division:", number1 / number2)


# -----------------------------------------
# 4. Checking number types
# -----------------------------------------
# type() tells us what type of value
# we are working with.

whole_number = 10
decimal_number = 3.14
complex_number = 1 + 2j

print("Type of whole number:", type(whole_number))
print("Type of decimal number:", type(decimal_number))
print("Type of complex number:", type(complex_number))


# -----------------------------------------
# 5. Integers and arithmetic
# -----------------------------------------
# An integer (int) is a whole number
# without a decimal point.

print("Addition:", 1 + 2)
print("Subtraction:", 2 - 1)
print("Multiplication:", 2 * 3)
print("Division:", 7 / 2)

# Floor division (//) divides two numbers
# and rounds the result down.

print("Floor division:", 12 // 5)
print("Floor division:", 7 // 3)

# Modulus (%) gives the remainder after division.

print("Modulus:", 3 % 2)

# Exponentiation (**) raises a number
# to a power.

print("Exponentiation:", 3 ** 2)


# -----------------------------------------
# 6. Floating-point numbers
# -----------------------------------------
# A float is a number that contains
# a decimal point.

print("Floating point number:", 3.14)
print("Floating point number:", 9.81)

pi = 3.14
gravity = 9.81

print("PI:", pi)
print("Gravity:", gravity)

print("Type of pi:", type(pi))
print("Type of gravity:", type(gravity))


# -----------------------------------------
# 7. Complex numbers
# -----------------------------------------
# A complex number contains a real part
# and an imaginary part.
#
# The letter j represents the imaginary part
# in Python.

print("Complex number:", 1 + 1j)

complex_number1 = 1 + 1j
complex_number2 = 1 - 1j

print(
    "Multiplying complex numbers:",
    complex_number1 * complex_number2
)


# -----------------------------------------
# 8. Comparison operators
# -----------------------------------------
# Comparison operators compare two values
# and return True or False.

print("3 == 2:", 3 == 2)
print("3 != 2:", 3 != 2)
print("3 > 2:", 3 > 2)
print("3 < 2:", 3 < 2)
print("3 >= 2:", 3 >= 2)
print("3 <= 2:", 3 <= 2)


# -----------------------------------------
# 9. Comparing numbers stored in variables
# -----------------------------------------

a = 10
b = 5

print("a == b:", a == b)
print("a != b:", a != b)
print("a > b:", a > b)
print("a < b:", a < b)
print("a >= b:", a >= b)
print("a <= b:", a <= b)


# -----------------------------------------
# 10. Comparing lengths of strings
# -----------------------------------------
# len() gives us the number of characters
# in a string.
#
# We can compare those lengths using
# comparison operators.

print(len("mango") == len("banana"))
print(len("mango") != len("banana"))
print(len("mango") > len("banana"))
print(len("mango") < len("banana"))
print(len("mango") >= len("banana"))
print(len("mango") <= len("banana"))


# -----------------------------------------
# 11. Comparing string lengths with messages
# -----------------------------------------

word1 = "Python"
word2 = "Java"

print("Length of Python:", len(word1))
print("Length of Java:", len(word2))

print("Is Python longer:", len(word1) > len(word2))


# -----------------------------------------
# 12. Simple number comparison practice
# -----------------------------------------
# Let's store comparison results in variables.

number1 = 25
number2 = 15

is_greater = number1 > number2
is_equal = number1 == number2
is_smaller = number1 < number2

print("Is number1 greater:", is_greater)
print("Are the numbers equal:", is_equal)
print("Is number1 smaller:", is_smaller)

# ==========================================
# DAY 4 COMPLETE
# ==========================================
